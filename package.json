{
  "name": "seasonal-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side scaler/converter tests (Node's built-in test runner, zero deps).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/js/*.test.js",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/js/*.test.js"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-document": "^3.28.0",
    "@tiptap/extension-history": "^3.28.0",
    "@tiptap/extension-paragraph": "^3.28.0",
    "@tiptap/extension-text": "^3.28.0",
    "@tiptap/pm": "^3.28.0"
  }
}
