# The database is generated by build_db.py AND holds personal data
# (your ratings and cook history). Don't commit it.
recipes.db
recipes.db-journal
recipes.db-wal
recipes.db-shm

# Recipe hero photos — generated by scripts/backfill_photos.py from the Paprika archive (and any
# you drop in by hand). Regenerable, so not committed; keep the folder's README tracked.
static/images/*.jpg
static/images/*.jpeg
static/images/*.png
static/images/*.webp

# Runtime cook-photo uploads (album + hero) — user data written by the app at run time. The *.jpg glob
# above doesn't recurse into this subdir, so ignore it explicitly (keeps runtime uploads out of commits).
static/images/cooks/

# The raw vocabulary store, built by build_sources_db.py. Six public food vocabularies
# ingested whole and unmodified. Regenerable, large, and NOT owned by migrate.py or Alembic.
sources.db
sources.db-journal
sources.db-wal
sources.db-shm

# Local backups (made by backup.py)
backups/

# Design-review preview HTML (generated; viewed locally, never committed)
previews/
preview/

# Paprika recipe exports — bulk data, not code (the native archive is 200 MB+).
# Read-only import tooling unpacks these to a scratch dir; never commit them.
*.paprikarecipes
*.paprikarecipe

# Paprika HTML-export study data — no longer the import source (we're on native now);
# kept on disk as possible fallback-reader material for the friends-migration tool.
/index.html
/paprika_samples/

# Frontend build tooling (Vite) — deps + build output are generated, not committed.
# The frontend is built on deploy (npm run build → dist/); Flask serves dist/ at runtime.
node_modules/
dist/
.vite/

# Coverage reports — generated by the test runs (pytest --cov and npm run test:coverage),
# consumed by the SonarQube step. Regenerable, never committed.
coverage/
coverage.xml

# Python bytecode caches
__pycache__/
*.pyc

# Virtual environment, if you make one
.venv/
venv/

# Claude Code local settings (permissions, not project config)
.claude/

# Editor / OS noise
.vscode/
.DS_Store

# The name buckets over sources.db, built by build_join.py. Derived, rebuildable in
# 40 seconds from sources.db, and ~900 MB. Never committed.
#
# join-narrow-1.db is the superseded rule_version, kept so the 200-bucket error rate and
# the English-gloss measurement stay reproducible against the artifact they were taken on.
join.db
join.db-journal
join.db-wal
join.db-shm
join-*.db
join-*.db-journal
join-*.db-wal
join-*.db-shm

# The ingredient library's id -> canonical-name lookup, derived from join.db (which is itself derived
# from sources.db). ~624 KB, two columns, loaded into the library_names table by build_db.py's
# seed_library_names. SERVER-SIDE: placed by hand on a machine that has generated it, never committed.
# A clone without it builds a working app with an EMPTY lookup, which self-disables the add-on-save
# create path rather than breaking anything.
library_names.csv

# The linkage matcher's regenerable output (study/matcher/). The SOURCE and the hand-judged
# sets are committed. Everything below is recomputed by rerunning, and the checkpoints alone
# were 244 MB in the scratch tree they were rescued from.
study/matcher/*.pkl
study/matcher/*.xlsx
study/matcher/*.out
study/matcher/*.csv
study/matcher/*.html

# ⚠️ previews/agree-sample.csv is TRACKED despite previews/ above, and it is force-added rather
# than un-ignored. A negation cannot reach it: git never descends into a directory excluded by a
# trailing-slash rule, so `!previews/agree-sample.csv` would be inert. It is tracked because
# AJ60.py's 60 verdicts are keyed by SAMPLE INDEX and the AGREE block moves between HEADs, so
# that file IS the judgment record rather than a regenerable report. Once tracked it stays
# tracked, and .gitignore does not apply to tracked files.
